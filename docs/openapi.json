    "/api/v1/lookups/countries": {
      "get": {
        "tags": [
          "Lookups"
        ],
        "summary": "ISO 3166 country codes and names used by the forms.",
        "operationId": "ListCountries",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CountryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools": {
      "get": {
        "tags": [
          "Tools"
        ],
        "summary": "The tool definitions registered with the assistant, in prompt order.",
        "operationId": "ListTools",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
