  "components": {
    "schemas": {
      "BookingStatusResponse": {
        "required": [
          "bookingId",
          "service",
          "status",
          "total",
          "paymentUrl",
          "createdAt",
          "confirmedAt"
        ],
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "total": {
            "$ref": "#/components/schemas/MoneyResponse"
          },
          "paymentUrl": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ChatMessageResponse": {
        "required": [
          "reply",
          "locale",
          "direction",
          "state",
          "structuredData"
        ],
        "type": "object",
        "properties": {
          "reply": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "structuredData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StructuredDataBlock"
            }
          }
        }
      },
      "ContactDetails": {
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CountryResponse": {
        "required": [
          "code",
          "name"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "FormAcceptedResponse": {
        "required": [
          "message",
          "locale",
          "direction",
          "paymentMethods",
          "nextStep"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "paymentMethods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentMethod"
            }
          },
          "nextStep": {
            "type": "string"
          }
        }
      },
      "GuestFormRequest": {
        "type": "object",
        "properties": {
          "leadGuest": {
            "$ref": "#/components/schemas/LeadGuestDetails"
          },
          "contact": {
            "$ref": "#/components/schemas/ContactDetails"
          },
          "specialRequests": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HistoryItem": {
        "required": [
          "role",
          "text",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HistoryResponse": {
        "required": [
