            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SendMessageRequest": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "StartChatRequest": {
        "required": [
          "locale"
        ],
        "type": "object",
        "properties": {
          "locale": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StartChatResponse": {
        "required": [
          "sessionToken",
          "expiresAt",
          "greeting",
          "locale",
          "direction",
          "assistantName"
        ],
        "type": "object",
        "properties": {
          "sessionToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "greeting": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "assistantName": {
            "type": "string"
          }
        }
      },
      "StructuredDataBlock": {
        "required": [
          "state",
          "data"
