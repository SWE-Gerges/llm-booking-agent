            ]
          },
          "dateOfBirth": {
            "type": [
              "null",
              "string"
            ]
          },
          "gender": {
            "type": [
              "null",
              "string"
            ]
          },
          "nationality": {
            "type": [
              "null",
              "string"
            ]
          },
          "passportNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "passportExpiry": {
