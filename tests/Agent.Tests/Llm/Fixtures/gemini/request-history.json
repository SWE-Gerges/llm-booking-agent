  "tools": [
    {
      "functionDeclarations": [
        {
          "name": "search_flights",
          "description": "Search flight offers.",
          "parameters": {
            "type": "OBJECT",
            "properties": {
              "origin": {
                "type": "STRING",
                "pattern": "^[A-Za-z]{3}$",
                "description": "Departure airport code"
              },
              "adults": {
                "type": "INTEGER",
                "minimum": 1,
                "maximum": 9
              },
              "cabin": {
                "type": "STRING",
                "enum": [
                  "economy",
                  "business"
                ]
              },
              "fares": {
                "type": "ARRAY",
                "items": {
                  "type": "STRING"
                },
                "maxItems": 3
              },
              "maxPrice": {
                "type": "NUMBER"
              },
              "note": {
                "type": "STRING",
                "nullable": true
              }
            },
            "required": [
              "origin"
            ]
          }
        },
        {
          "name": "get_booking_status",
          "description": "Report booking status."
        }
      ]
    }
  ],
  "generationConfig": {
    "maxOutputTokens": 512
