<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Tests are in-memory and deterministic; tokens are passed explicitly where cancellation is the behaviour under test. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Agent.Abstractions\Agent.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Agent.Core\Agent.Core.csproj" />
    <ProjectReference Include="..\..\src\Agent.Llm\Agent.Llm.csproj" />
    <ProjectReference Include="..\..\src\Agent.Persistence\Agent.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Agent.Domains.Shared\Agent.Domains.Shared.csproj" />
    <ProjectReference Include="..\..\src\Agent.Domains.Flights\Agent.Domains.Flights.csproj" />
    <ProjectReference Include="..\..\src\Agent.Domains.Hotels\Agent.Domains.Hotels.csproj" />
    <ProjectReference Include="..\..\src\Agent.Domains.Transfers\Agent.Domains.Transfers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Security/Corpus/injection-corpus.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Llm/Fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
