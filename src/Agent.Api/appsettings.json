{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "Provider": "Anthropic"
  },
  "Anthropic": {
    "BaseUrl": "https://api.anthropic.com/",
    "Model": "claude-sonnet-5-5",
    "TimeoutSeconds": 60
  },
  "Agent": {
    "AssistantName": "Aria",
    "Currency": "EUR",
    "TimeZone": "UTC",
    "DefaultLocale": "en",
    "HistoryWindow": 20,
    "TrimChunk": 8,
    "MaxToolIterations": 8,
    "TurnTimeoutSeconds": 180,
    "MaxMessageLength": 2000,
    "MaxTokens": 1024
  },
  "Session": {
    "IdleTtlMinutes": 30
  },
  "Retention": {
    "Enabled": true,
    "RunIntervalMinutes": 15,
    "GraceMinutes": 60,
    "BatchSize": 100,
    "MaxBatchesPerRun": 50
  },
  "RateLimiting": {
    "Enabled": true,
    "SessionMessagesPerWindow": 30,
    "IpRequestsPerWindow": 120,
    "SessionStartsPerWindow": 60,
    "WindowSeconds": 60
  },
  "Persistence": {
    "Provider": "Postgres",
    "MigrateOnStartup": true
  },
  "Backends": {
    "Flights": {
      "Provider": "InMemory"
    },
    "Fake": {
      "AutoConfirmAfterSeconds": 30
    }
  },
  "Auth": {
    "SessionTokenLifetimeMinutes": 120
  }
}
